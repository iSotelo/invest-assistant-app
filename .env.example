# Copiar este archivo a .env y completar con valores reales.
# .env nunca se sube al repositorio (ver .gitignore).

# Clave de la API de OpenAI, usada por el motor semantico de validacion INVEST.
OPENAI_API_KEY=

# Modelo a usar para la evaluacion semantica (JSON mode).
OPENAI_MODEL=gpt-4o-mini

# URL base del backend, usada por el frontend de Streamlit.
BACKEND_API_URL=http://localhost:8000

# Timeout (segundos) para llamadas al LLM antes de degradar a solo-reglas.
LLM_TIMEOUT_SECONDS=5
